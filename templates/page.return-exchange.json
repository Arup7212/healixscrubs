          "settings": {
            "title": "Damaged or Incorrect Products",
            "text": "<p>If you receive a product that is damaged, defective, incorrect, or different from what you ordered, please contact us as soon as possible.</p><p>To help us resolve the issue quickly, please provide:</p><ul><li>Order number<br/></li><li>Description of the issue<br/></li><li>Clear photographs of the product<br/></li><li>Photographs of the packaging, where applicable<br/></li></ul><p>After reviewing the request, we may offer a replacement, exchange, refund, or another appropriate resolution depending on the circumstances.</p>"
          }
        },
        "policy_zyxVnb": {
          "type": "policy",
          "settings": {
            "title": "Size Exchanges",
            "text": "<p>If you have ordered the wrong size, you may request an exchange subject to product availability and our applicable exchange conditions.</p><p>The product must be unused, unwashed, and in its original condition with tags and packaging intact.</p><p>Any applicable shipping or exchange charges will be communicated before processing the exchange.</p>"
