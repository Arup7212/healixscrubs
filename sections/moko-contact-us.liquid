      "type": "textarea",
      "id": "form_subheading",
      "label": "Form Subheading",
      "default": "Fill out the form below and our customer care team will get back to you promptly."
    },
    {
      "type": "text",
      "id": "map_title",
      "label": "Map Header Title",
      "default": "Headquarters Location"
