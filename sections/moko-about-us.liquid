        { "type": "text", "id": "val_title_1", "label": "Value 1 Title", "default": "Premium Comfort" },
        { "type": "textarea", "id": "val_text_1", "label": "Value 1 Text" },
        { "type": "image_picker", "id": "val_icon_2", "label": "Value 2 Icon (Image)" },
        { "type": "text", "id": "val_title_2", "label": "Value 2 Title", "default": "Functional Design" },
        { "type": "textarea", "id": "val_text_2", "label": "Value 2 Text" },
