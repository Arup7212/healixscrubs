        { "type": "image_picker", "id": "icon_2", "label": "Icon 2 (Image)" },
        { "type": "text", "id": "icon_title_2", "label": "Icon 2 Title" },
        { "type": "text", "id": "icon_text_2", "label": "Icon 2 Text" },
        { "type": "image_picker", "id": "icon_3", "label": "Icon 3 (Image)" },
        { "type": "text", "id": "icon_title_3", "label": "Icon 3 Title" },
