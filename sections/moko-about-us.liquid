{{ 'about-us.css' | asset_url | stylesheet_tag }}

<div class="about-us-wrapper">
  {% for block in section.blocks %}
    {% case block.type %}
      
      {% when 'hero' %}
        <div class="about-hero" {{ block.shopify_attributes }}>
          <div class="about-container" style="display: flex; align-items: center; width: 100%;">
            <div class="about-hero__content">
              {% if block.settings.subtitle != blank %}
                <div class="about-subtitle">{{ block.settings.subtitle }}</div>
              {% endif %}
              {% if block.settings.title != blank %}
                <h1 class="about-title">{{ block.settings.title }}</h1>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="about-text">{{ block.settings.text }}</div>
              {% endif %}
              {% if block.settings.button_label != blank %}
                <a href="{{ block.settings.button_link }}" class="about-btn">{{ block.settings.button_label }}</a>
              {% endif %}
              
              <div class="about-hero__features">
                {% for i in (1..3) %}
                  {% assign icon_key = 'feature_icon_' | append: i %}
                  {% assign text_key = 'feature_text_' | append: i %}
                  {% if block.settings[icon_key] != blank and block.settings[text_key] != blank %}
                    <div class="about-hero__feature">
                      {{ block.settings[icon_key] | image_url: width: 60 | image_tag: loading: 'lazy' }}
                      <span>{{ block.settings[text_key] }}</span>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
            <div class="about-hero__image">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
          </div>
        </div>

      {% when 'image_text' %}
        <div class="about-section {% if block.settings.bg_color == 'white' %}about-section--white{% else %}about-section--light{% endif %}" {{ block.shopify_attributes }}>
          <div class="about-container">
            <div class="about-image-text {% if block.settings.layout == 'image_right' %}about-image-text--reverse{% endif %}">
              <div class="about-image-text__image">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
              </div>
              <div class="about-image-text__content">
                {% if block.settings.subtitle != blank %}
                  <div class="about-subtitle">{{ block.settings.subtitle }}</div>
                {% endif %}
                {% if block.settings.title != blank %}
                  <h2 class="about-title">{{ block.settings.title }}</h2>
                {% endif %}
                {% if block.settings.text != blank %}
                  <div class="about-text">{{ block.settings.text }}</div>
                {% endif %}
                {% if block.settings.button_label != blank %}
                  <a href="{{ block.settings.button_link }}" class="about-btn">{{ block.settings.button_label }}</a>
                {% endif %}

                {% if block.settings.show_fabric_icons %}
                  <div class="fabric-icons" style="display:flex; flex-direction:column; gap:20px; margin-top:30px;">
                    {% for i in (1..3) %}
                      {% assign icon_key = 'icon_' | append: i %}
                      {% assign title_key = 'icon_title_' | append: i %}
                      {% assign text_key = 'icon_text_' | append: i %}
                      {% if block.settings[icon_key] != blank %}
                        <div style="display:flex; align-items:center; gap:15px;">
                          <div style="width:50px; height:50px; background:#f6f5f3; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                            {{ block.settings[icon_key] | image_url: width: 30 | image_tag: loading: 'lazy' }}
                          </div>
                          <div>
                            <div style="font-weight:700; font-size:14px; color:#173C2B;">{{ block.settings[title_key] }}</div>
                            <div style="font-size:12px; color:#666;">{{ block.settings[text_key] }}</div>
                          </div>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}

                {% if block.settings.show_commitment_icons %}
                  <div class="commitment-features">
                    {% for i in (1..3) %}
                      {% assign icon_key = 'icon_' | append: i %}
                      {% assign title_key = 'icon_title_' | append: i %}
                      {% if block.settings[icon_key] != blank %}
                        <div style="text-align:center;">
                          <div style="margin-bottom:10px; color:#173C2B;">
                            {{ block.settings[icon_key] | image_url: width: 40 | image_tag: loading: 'lazy' }}
                          </div>
                          <div style="font-size:12px; font-weight:600;">{{ block.settings[title_key] }}</div>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                  {% if block.settings.commitment_footer_text != blank %}
                    <div style="font-weight:600; font-style:italic; text-align:center; color:#173C2B;">{{ block.settings.commitment_footer_text }}</div>
                  {% endif %}
                {% endif %}

              </div>
            </div>
          </div>
        </div>

      {% when 'values' %}
        <div class="about-section about-section--light" {{ block.shopify_attributes }}>
          <div class="about-container">
            <div class="about-values-header">
              {% if block.settings.subtitle != blank %}
                <div class="about-subtitle">{{ block.settings.subtitle }}</div>
              {% endif %}
              <h2 class="about-title" style="margin-bottom:10px;">{{ block.settings.title }}</h2>
              {% if block.settings.text != blank %}
                <p style="color:#666;">{{ block.settings.text }}</p>
              {% endif %}
            </div>
            <div class="about-values-grid">
              {% for i in (1..4) %}
                {% assign icon_key = 'val_icon_' | append: i %}
                {% assign title_key = 'val_title_' | append: i %}
                {% assign text_key = 'val_text_' | append: i %}
                {% if block.settings[title_key] != blank %}
                  <div class="about-value-card">
                    <div class="about-value-icon">
                      {% if block.settings[icon_key] != blank %}
                        {{ block.settings[icon_key] | image_url: width: 40 | image_tag: loading: 'lazy' }}
                      {% endif %}
                    </div>
                    <div class="about-value-title">{{ block.settings[title_key] }}</div>
                    <div class="about-value-text">{{ block.settings[text_key] }}</div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>

      {% when 'stats' %}
        <div class="about-stats" style="background-color: #f6f5f3;" {{ block.shopify_attributes }}>
          <div class="about-container">
            <div class="about-stats-subtitle">{{ block.settings.subtitle }}</div>
            <div class="about-stats-grid">
              {% for i in (1..4) %}
                {% assign icon_key = 'stat_icon_' | append: i %}
                {% assign num_key = 'stat_num_' | append: i %}
                {% assign label_key = 'stat_label_' | append: i %}
                {% assign sub_key = 'stat_sub_' | append: i %}
                {% if block.settings[num_key] != blank %}
                  <div class="about-stat-item">
                    {% if block.settings[icon_key] != blank %}
                      {{ block.settings[icon_key] | image_url: width: 40 | image_tag: loading: 'lazy' }}
                    {% endif %}
                    <div class="about-stat-num">{{ block.settings[num_key] }}</div>
                    <div class="about-stat-label">
                      <strong>{{ block.settings[label_key] }}</strong><br>
                      <span style="font-size:12px;">{{ block.settings[sub_key] }}</span>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>

      {% when 'cta' %}
        <div class="about-cta" style="{% if block.settings.image != blank %}background-image: url('{{ block.settings.image | image_url: width: 2000 }}');{% endif %}" {{ block.shopify_attributes }}>
          <div class="about-cta-content">
            <h2 class="about-title">{{ block.settings.title }}</h2>
            <div class="about-text" style="margin-bottom:40px;">{{ block.settings.text }}</div>
            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link }}" class="about-cta-btn">{{ block.settings.button_label }}</a>
            {% endif %}
          </div>
        </div>

    {% endcase %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "MOKO About Us Page",
  "settings": [],
  "blocks": [
    {
      "type": "hero",
      "name": "Hero Section",
      "settings": [
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "ABOUT US" },
        { "type": "text", "id": "title", "label": "Title", "default": "Designed for Care. Made for Comfort." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We create premium medical scrubs...</p>" },
        { "type": "text", "id": "button_label", "label": "Button Label", "default": "OUR STORY →" },
        { "type": "url", "id": "button_link", "label": "Button Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "feature_icon_1", "label": "Feature 1 Icon (Image)" },
        { "type": "text", "id": "feature_text_1", "label": "Feature 1 Text", "default": "Premium Cotton Fabric" },
        { "type": "image_picker", "id": "feature_icon_2", "label": "Feature 2 Icon (Image)" },
        { "type": "text", "id": "feature_text_2", "label": "Feature 2 Text", "default": "Made for Real Work" },
