<style>
.mask-features-section {
  text-align: center;
  padding: 0px 16px 40px 16px;
  max-width: 1200px;
  margin: 0 auto;
  font-family: inherit;
}

@media(min-width:768px){
  .mask-features-section{
  padding: 0px 16px 60px 16px;

  }
}

.mask-features-header {
  margin-bottom: 40px;
}

.mask-features-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.mask-features-column {
  flex: 1 1 250px;
  display: flex;
  flex-direction: column;
  gap: 50px;
}

.mask-feature-item {
  text-align: center;
}

.mask-feature-icon {
  margin-bottom: 16px;
}

.mask-feature-icon img {
  max-width: 54px;
  height: auto;
  display: inline-block;
}

.mask-feature-title {
  font-family: 'Jost', sans-serif;
  font-size: 18px;
  font-weight: 700;
  color: #173C2B;
  margin-bottom: 8px;
}

.mask-feature-text {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: #4b5563;
  margin: 0 auto;
}

.mask-main-image {
  flex: 2 1 380px;
  text-align: center;
}

.mask-main-image img {
  max-width: 100%;
  height: auto;
  border-radius: 4px;
}

@media (max-width: 900px) {
  .mask-features-container {
    flex-direction: column;
    gap: 30px;
  }
  
  .mask-main-image {
    order: -1;
    margin-bottom: 10px;
    width: 100%;
  }
  
  .mask-features-column {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 16px;
    width: 100%;
  }
}
</style>

<div class="mask-features-section">
  <div class="container">
    <div class="mask-features-header">
      {% if section.settings.heading != blank %}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="section-tagline">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  </div>

  <div class="mask-features-container">
    <div class="mask-features-column">
      {% for block in section.blocks limit: 2 %}
        <div class="mask-feature-item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="mask-feature-icon">
              <img src="{{ block.settings.icon | img_url: 'master' }}" alt="{{ block.settings.title | escape }}">
            </div>
          {% endif %}
          {% if block.settings.title != blank %}
            <div class="mask-feature-title">{{ block.settings.title }}</div>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="mask-feature-text">{{ block.settings.text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="mask-main-image">
      {% if section.settings.main_image != blank %}
        <img src="{{ section.settings.main_image | img_url: 'master' }}" alt="Main Image">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    <div class="mask-features-column">
      {% for block in section.blocks offset: 2 limit: 2 %}
        <div class="mask-feature-item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="mask-feature-icon">
              <img src="{{ block.settings.icon | img_url: 'master' }}" alt="{{ block.settings.title | escape }}">
            </div>
          {% endif %}
          {% if block.settings.title != blank %}
            <div class="mask-feature-title">{{ block.settings.title }}</div>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="mask-feature-text">{{ block.settings.text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mask Features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comfortability. Durability. Safety"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "DURABLE FACE MASKS"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Feature description text goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mask Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Anti-Pollution",
            "text": "Tortor posuere ac ut consequat semper viverra nam libero justo."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Prevents Tiny Droplets",
            "text": "Erat imperdiet sed euismod nisi porta lorem. Justo nec ultrices."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Filters Out 95%",
            "text": "Orci nulla pellentesque dignissim enim sit apien eget mi proin sed."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Comfortable Breathing",
            "text": "Quis lectus nulla at volutpat diam ut venenatis tellussagittis purus."
          }
        }
      ]
    }
  ]
}
{% endschema %}
