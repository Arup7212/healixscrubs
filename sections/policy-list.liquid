{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .policy-section-wrapper {
    background-color: #fafafa;
    width: 100%;
  }

  .policy-list-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .policy-list-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #111827;
  }

  .policy-list-desc {
    color: #4b5563;
    font-size: 1rem;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .policy-list-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    margin-top: 1.5rem;
  }

  .policy-list-item {
    position: relative;
    display: flex;
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    padding: 2rem;
    gap: 2rem;
  }

  .policy-item-left {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    flex: 0 0 35%;
  }

  .policy-item-number {
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    background-color: #e9efe7;
    color: #2c362c;
    font-size: 14px;
    font-weight: 700;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    z-index: 2;
    line-height: 1;
  }

  .policy-item-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    padding-top: 4px;
    color: #111827;
  }

  .policy-item-right {
    flex: 1;
  }

  .policy-item-content {
    color: #374151;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .policy-item-content p {
    margin-top: 0;
    margin-bottom: 1rem;
  }
  
  .policy-item-content p:last-child {
    margin-bottom: 0;
  }

  .policy-item-content ul, .policy-item-content ol {
    padding-left: 1.25rem;
    margin-top: 0;
    margin-bottom: 1rem;
  }
  
  .policy-item-content ul:last-child, .policy-item-content ol:last-child {
    margin-bottom: 0;
  }

  .policy-item-content li {
    margin-bottom: 0.5rem;
  }

  .policy-item-content--two-cols ul,
  .policy-item-content--two-cols ol {
    column-count: 2;
    column-gap: 2rem;
  }

  /* Responsive Design */
  @media screen and (max-width: 768px) {
    .policy-list-container {
      grid-template-columns: 1fr;
    }
    
    .policy-list-item {
      flex-direction: column;
      padding: 1.5rem;
      gap: 1rem;
    }
    
    .policy-item-left {
      flex: none;
      align-items: center;
      gap: 1rem;
    }
    
    .policy-item-number {
      font-size: 2rem;
    }
    
    .policy-item-title {
      padding-top: 0;
    }

    .policy-item-content--two-cols ul,
    .policy-item-content--two-cols ol {
      column-count: 1;
    }
  }
{%- endstyle -%}

<div class="policy-section-wrapper">
  <div class="container section-{{ section.id }}-padding">
    {%- if section.settings.title != blank or section.settings.description != blank -%}
    <div class="policy-list-header">
      {%- if section.settings.title != blank -%}
        <h2 class="policy-list-title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="policy-list-desc">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="policy-list-container">
    {%- for block in section.blocks -%}
      <div class="policy-list-item" {{ block.shopify_attributes }}>
        <div class="policy-item-left">
          <span class="policy-item-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="policy-item-title">{{ block.settings.title | escape }}</h3>
        </div>
        <div class="policy-item-right">
          <div class="policy-item-content {% if block.settings.two_columns %}policy-item-content--two-cols{% endif %}">
            {{ block.settings.content }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  </div>
</div>

{% schema %}
{
  "name": "Policy List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Privacy Policy"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>At our store, we respect your privacy and are committed to protecting your personal information.</p>"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "policy_item",
      "name": "Policy Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Item Title",
          "default": "Information We Collect"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>When you visit our website or purchase from us, we may collect information.</p>"
        },
        {
          "type": "checkbox",
          "id": "two_columns",
          "label": "Display lists in two columns",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Policy List",
      "blocks": [
        {
          "type": "policy_item"
        },
        {
          "type": "policy_item"
        },
        {
          "type": "policy_item"
        }
      ]
    }
  ]
}
{% endschema %}
