{{ 'moko-collection-highlight.css' | asset_url | stylesheet_tag }}

<div class="moko-col-highlight" style="background-color: {{ section.settings.bg_color }};">
  <div class="moko-col-highlight__container container">
    <div class="moko-col-highlight__text-wrap">
      {% if section.settings.subtitle != blank %}
        <span class="moko-col-highlight__subtitle">{{ section.settings.subtitle }}</span>
      {% endif %}
      
      {% if section.settings.title != blank %}
        <h2 class="section-title">{{ section.settings.title }}</h2>
      {% endif %}
      
      {% if section.settings.text != blank %}
        <p class="section-details">{{ section.settings.text }}</p>
      {% endif %}
      
      {% if section.settings.btn_label != blank %}
        {% assign btn_link = section.settings.btn_link | default: section.settings.collection.url | default: '#' %}
        <a href="{{ btn_link }}" class="moko-col-highlight__btn">
          {{ section.settings.btn_label }}
        </a>
      {% endif %}
    </div>

    <div class="moko-col-highlight__grid">
      {% assign collection = section.settings.collection %}
      {% if collection != blank and collection.products_count > 0 %}
        {% for product in collection.products limit: 4 %}
          {% capture bg_color %}
            {% cycle '#e6f5ea', '#f5e6e6', '#e6f0f5', '#f5f0e6' %}
          {% endcapture %}
          <a href="{{ product.url }}" class="moko-col-highlight__card" style="background-color: {{ bg_color }};">
            {% if product.featured_image != blank %}
              {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
            {% else %}
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          {% capture bg_color %}
            {% cycle '#e6f5ea', '#f5e6e6', '#e6f0f5', '#f5f0e6' %}
          {% endcapture %}
          <a href="#" class="moko-col-highlight__card" style="background-color: {{ bg_color }};">
            {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MOKO Collection Highlight",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#f8f9fa"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Our Collections"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Styles That Work As Hard As You Do"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "From classic solids to modern fits — our collections are made for every role and every routine."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection",
      "info": "Products from this collection will be shown in the grid."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "EXPLORE COLLECTIONS"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link",
      "info": "Leave blank to link to the selected collection automatically."
    }
  ],
  "presets": [
    {
      "name": "MOKO Collection Highlight"
    }
  ]
}
{% endschema %}
