{%- if product.variants.size > 1 -%}
  <style>
    .product-card-variant-pill {
      border: 1px solid #d1d1d1;
      padding: 6px 10px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 4px;
      color: #111111;
      background-color: #ffffff;
      text-decoration: none;
      text-transform: uppercase;
      transition: all 0.2s ease;
    }
    .product-card-variant-pill:hover {
      border-color: #111111;
      background-color: #f0f0f0;
      color: #000000;
    }
    .product-card-variant-pill--sold-out {
      border-color: #e8e8e8;
      color: #b0b0b0;
      background-color: #f5f5f5;
      text-decoration: line-through;
    }
    .product-card-variant-pill--sold-out:hover {
      border-color: #e8e8e8;
      background-color: #f5f5f5;
      color: #b0b0b0;
    }
  </style>
  <div class="product-card-variants-wrapper" style="margin-top: 10px; display: flex; flex-wrap: wrap; gap: 8px; position: relative; z-index: 2;">
    {%- for option in product.options_with_values -%}
      {%- if option.name == 'Size' or option.name == 'size' or option.name == 'Size (US)' or option.name == 'Length' or option.name == 'Width' -%}
        {%- assign option_pos = 'option' | append: option.position -%}
        {%- for value in option.values -%}
          {%- assign target_variant = value.variant -%}
          {%- if target_variant == blank -%}
            {%- for variant in product.variants -%}
              {%- if variant[option_pos] == value.name -%}
                {%- assign target_variant = variant -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- assign variant_url = product.url -%}
          {%- if target_variant != blank -%}
            {%- assign variant_url = product.url | append: '?variant=' | append: target_variant.id -%}
          {%- endif -%}
          <a href="{{ variant_url }}" class="product-card-variant-pill {% if value.available == false %}product-card-variant-pill--sold-out{% endif %}">
            {{ value.name }}
          </a>
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

