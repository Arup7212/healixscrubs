{%- if product.metafields.custom.product_details != blank or product.metafields.custom.fabric_care != blank or product.metafields.custom.shipping_returns != blank -%}
  <product-info-tabs class="product-info-tabs" data-product-tabs style="--margin-top: {{ block.settings.margin_top }}px; --margin-bottom: {{ block.settings.margin_bottom }}px;">
    <div class="product-info-tabs__header">
      {%- if product.metafields.custom.product_details != blank -%}
        <button class="product-info-tabs__tab active" data-tab-target="details">{{ block.settings.details_tab_label | default: 'Product Details' }}</button>
      {%- endif -%}
      {%- if product.metafields.custom.fabric_care != blank -%}
        <button class="product-info-tabs__tab {% if product.metafields.custom.product_details == blank %}active{% endif %}" data-tab-target="fabric">{{ block.settings.fabric_tab_label | default: 'Fabric & Care' }}</button>
      {%- endif -%}
      {%- if product.metafields.custom.shipping_returns != blank -%}
        <button class="product-info-tabs__tab {% if product.metafields.custom.product_details == blank and product.metafields.custom.fabric_care == blank %}active{% endif %}" data-tab-target="shipping">{{ block.settings.shipping_tab_label | default: 'Shipping & Returns' }}</button>
      {%- endif -%}
    </div>
    
    <div class="product-info-tabs__content-wrapper">
      {%- if product.metafields.custom.product_details != blank -%}
        <div class="product-info-tabs__content active" data-tab-content="details">
          {{ product.metafields.custom.product_details | metafield_tag }}
        </div>
      {%- endif -%}
      {%- if product.metafields.custom.fabric_care != blank -%}
        <div class="product-info-tabs__content {% if product.metafields.custom.product_details == blank %}active{% endif %}" data-tab-content="fabric">
          {{ product.metafields.custom.fabric_care | metafield_tag }}
        </div>
      {%- endif -%}
      {%- if product.metafields.custom.shipping_returns != blank -%}
        <div class="product-info-tabs__content {% if product.metafields.custom.product_details == blank and product.metafields.custom.fabric_care == blank %}active{% endif %}" data-tab-content="shipping">
          {{ product.metafields.custom.shipping_returns | metafield_tag }}
        </div>
      {%- endif -%}
    </div>
  </product-info-tabs>

  <script>
    if (!customElements.get('product-info-tabs')) {
      class ProductInfoTabs extends HTMLElement {
        constructor() {
          super();
          this.tabs = this.querySelectorAll('[data-tab-target]');
          this.contents = this.querySelectorAll('[data-tab-content]');

          this.tabs.forEach(tab => {
            tab.addEventListener('click', () => {
              const target = tab.dataset.tabTarget;
              
              // Remove active class from all
              this.tabs.forEach(t => t.classList.remove('active'));
              this.contents.forEach(c => c.classList.remove('active'));
              
              // Add active class to clicked tab and corresponding content
              tab.classList.add('active');
              const contentTarget = this.querySelector(`[data-tab-content="${target}"]`);
              if (contentTarget) {
                contentTarget.classList.add('active');
              }
            });
          });
        }
      }
      customElements.define('product-info-tabs', ProductInfoTabs);
    }
  </script>

  {% style %}
    .product-info-tabs {
      display: block;
      margin-top: var(--margin-top, 24px);
      margin-bottom: var(--margin-bottom, 24px);
      width: 100%;
    }
    
    .product-info-tabs__header {
      display: flex;
      border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
      margin-bottom: 2rem;
      gap: 2rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    
    .product-info-tabs__header::-webkit-scrollbar {
      display: none;
    }
    
    .product-info-tabs__tab {
      background: none;
      border: none;
      padding: 0 0 1.5rem 0;
      font-size: var(--font-paragraph--size, 1.5rem);
      font-weight: 500;
      color: rgb(var(--color-foreground-rgb) / 0.5);
      cursor: pointer;
      position: relative;
      white-space: nowrap;
      transition: color 0.3s ease;
      font-family: inherit;
    }
    
    .product-info-tabs__tab:hover {
      color: rgb(var(--color-foreground-rgb));
    }
    
    .product-info-tabs__tab.active {
      color: rgb(var(--color-foreground-rgb));
      font-weight: 600;
    }
    
    .product-info-tabs__tab.active::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 2px;
      background-color: rgb(var(--color-foreground-rgb));
    }
    
    .product-info-tabs__content {
      display: none;
      font-size: var(--font-paragraph--size, 1.5rem);
      line-height: var(--font-paragraph--line-height, 1.6);
      color: rgb(var(--color-foreground-rgb) / 0.8);
      animation: fadeIn 0.4s ease;
    }
    
    .product-info-tabs__content.active {
      display: block;
    }

    .product-info-tabs__content p {
      margin-bottom: 1rem;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(5px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Mobile adjustments */
    @media screen and (max-width: 749px) {
      .product-info-tabs__header {
        gap: 1.5rem;
      }
      .product-info-tabs__tab {
        font-size: var(--font-paragraph--size, 1.4rem);
      }
    }
  {% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Product Tabs",
  "settings": [
    {
      "type": "text",
      "id": "details_tab_label",
      "label": "Details Tab Label",
      "default": "Product Details"
    },
    {
      "type": "text",
      "id": "fabric_tab_label",
      "label": "Fabric & Care Tab Label",
      "default": "Fabric & Care"
    },
    {
      "type": "text",
      "id": "shipping_tab_label",
      "label": "Shipping & Returns Tab Label",
      "default": "Shipping & Returns"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 24
    }
  ]
}
{% endschema %}
