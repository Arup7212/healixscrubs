                    </svg>
                  </span>
                  <span style="font-size: 13px; color: #64748b; vertical-align: middle; font-family: inherit;">
                    If you have any questions, feel free to reply directly to this email.
                  </span>
                </div>

              </div>
            </div>
          `
        };

        // Loading state
        submitBtn.disabled = true;
        submitBtn.querySelector('.btn-text').textContent = 'Submitting...';
        submitBtn.querySelector('.btn-spinner').style.display = 'inline-block';

        try {
          const response = await fetch("https://api.brevo.com/v3/smtp/email", {
            method: "POST",
            headers: {
              "accept": "application/json",
              "api-key": apiKey,
              "content-type": "application/json"
            },
            body: JSON.stringify(emailPayload)
          });

          const data = await response.json();

          if (response.ok || data.messageId) {
            form.reset();
            form.style.display = 'none';
            successAlert.style.display = 'block';
          } else {
            errorAlert.textContent = data.message || data.error || 'Unable to submit estimate request. Please try again.';
            errorAlert.style.display = 'block';
          }
        } catch (err) {
          console.error('Estimator Submit Error:', err);
          errorAlert.textContent = 'Error connecting to email service. Note: If your browser blocks direct API calls (CORS), a backend proxy may be required.';
          errorAlert.style.display = 'block';
        } finally {
          submitBtn.disabled = false;
          submitBtn.querySelector('.btn-text').textContent = 'Send Estimate Request';
          submitBtn.querySelector('.btn-spinner').style.display = 'none';
        }
      });
    }
